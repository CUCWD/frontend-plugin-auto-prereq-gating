{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "babel.config.js",
    "jest.config.js",
    ".eslintrc.js"
  ]
}
